---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import { Code } from 'astro:components';
import ZMotion from '../components/ZMotion.astro';
import '../styles/home.css';
const example = `// Construye la query una sola vez.
const consulta = DB.Select([
  productoPrueba.nombreComercial,
  productoPrueba.descripcion,
])
  .from(productoPrueba())
  .where(eq(productoPrueba.activo, true))
  .LIMIT(5);

const mysql = await consulta.execute();
const pg = await consulta.execute(
  false, pgConex.getConexion()
);`;
const advantages = [
  {
    number: '01 / CONEXIONES',
    title: 'Una query. Tú eliges la base.',
    description:
      'Conserva el constructor de la consulta y ejecuta sobre MySQL o PostgreSQL pasando la conexión. El ejemplo de SELECT muestra cómo hacerlo.',
    href: '/docs/select/#misma-query-diferentes-conexiones',
    link: 'Ver la misma query en dos motores',
  },
  {
    number: '02 / TYPESCRIPT',
    title: 'Tu esquema vive en tu código.',
    description:
      'Define tablas y columnas en TypeScript y utilízalas con autocompletado. La misma definición sirve como punto de partida para generar su estructura en ambos motores.',
    href: '/docs/tables/',
    link: 'Explorar Tables',
  },
  {
    number: '03 / RESPUESTAS',
    title: 'Un formato que ya conoces.',
    description:
      'SELECT entrega arrays de objetos en los dos motores. INSERT con Returning devuelve arrays de identificadores: puedes conservar la forma de recorrerlos al cambiar la conexión.',
    href: '/docs/multiples-conexiones/',
    link: 'Comparar respuestas reales',
  },
  {
    number: '04 / CONTROL',
    title: 'Lee la query. Mira el SQL.',
    description:
      'Encadena columnas, filtros y uniones de forma explícita. Activa la salida SQL para inspeccionar la consulta que se envía a la base de datos.',
    href: '/docs/select/#execute',
    link: 'Inspeccionar una consulta',
  },
];
const guides = [
  [
    '01',
    'Instalación',
    'Tu primer paso con ZORMZ. Instala el paquete y elige cómo importarlo.',
    'instalacion',
  ],
  [
    '02',
    'Conexiones',
    'Conecta MySQL o PostgreSQL y configura tu entorno de trabajo.',
    'conexiones',
  ],
  [
    '03',
    'Consultas',
    'Lee, inserta, actualiza y elimina registros con una API encadenada.',
    'consultas',
  ],
  [
    '04',
    'Más de una conexión',
    'Construye una consulta y elige dónde ejecutarla.',
    'multiples-conexiones',
  ],
];
---

<Layout title="Un ORM ligero para TypeScript">
  <main id="contenido" class="home">
    <section class="section intro">
      <ZMotion />
      <div class="intro-copy">
        <p class="eyebrow">TYPESCRIPT → SQL, SIN RODEOS</p>
        <h1>
          Tu base de datos.
          <br />
          <em>Tu TypeScript.</em>
        </h1>
        <p class="lead">
          Un ORM ligero para escribir consultas claras,
          <br class="desktop" /> con el tipado que ya conoces.
        </p>
        <p class="intro-description">
          Conecta MySQL o PostgreSQL, define tu estructura y construye consultas
          sin salir de tu código.
        </p>
        <div class="action-row">
          <a class="button" href={withBase('/docs/instalacion/')}>
            Empezar a construir <span>↗</span>
          </a>
          <a class="text-link" href={withBase('/docs/consultas/')}>
            Ver los ejemplos →
          </a>
        </div>
        <div class="compat">
          <span>TypeScript</span>
          <span>MySQL</span>
          <span>PostgreSQL</span>
          <span>ESM + CommonJS</span>
        </div>
      </div>
      <div class="example-panel">
        <div class="panel-head">
          <span>
            <i></i> Una query. Dos conexiones.
          </span>
          <span>TS</span>
        </div>
        <div class="example-code">
          <Code
            code={example}
            lang="ts"
            themes={{ light: 'dark-plus', dark: 'dark-plus' }}
          />
          <button data-copy>Copiar</button>
        </div>
        <div class="panel-bottom">
          <span>Tipado. Legible. Encadenable.</span>
          <span>↳ SQL</span>
        </div>
      </div>
    </section>
    <div class="notice">
      <span class="notice-icon">i</span>
      <p>
        <strong>Una documentación que crece contigo.</strong> Esta es nuestra
        primera versión. Ya puedes generar y eliminar tablas desde las guías. La
        referencia de funciones llegará en una próxima etapa.
      </p>
      <span class="status">EN DESARROLLO</span>
    </div>
    <section class="section guide-section" id="guias">
      <div class="section-heading">
        <p class="eyebrow">DE CERO A TU PRIMERA CONSULTA</p>
        <h2>Un buen lugar para empezar.</h2>
        <span class="small-note">04 guías · Ejemplos en TypeScript</span>
      </div>
      <div class="guide-grid">
        {guides.map(([number, title, description, slug]) => (
          <a class="guide-card" href={withBase(`/docs/${slug}/`)}>
            <div class="card-top">
              <span>{number} / GUÍA</span>
              <span>↗</span>
            </div>
            <h3>{title}</h3>
            <p>{description}</p>
            <span class="card-link">
              Leer la guía <span>→</span>
            </span>
          </a>
        ))}
      </div>
    </section>
    <section class="section advantages">
      <div class="advantages-heading">
        <p class="eyebrow">POR QUÉ CONSTRUIR CON ZORMZ</p>
        <h2>
          Menos adaptación.
          <br />
          <em>Más continuidad.</em>
        </h2>
        <p>
          Si buscas consultas explícitas y trabajar con más de una conexión,
          estas son las capacidades de ZORMZ que puedes probar hoy.
        </p>
      </div>
      <div class="advantage-grid">
        {advantages.map(({ number, title, description, href, link }) => (
          <article class="advantage-card">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
            <a href={withBase(href)}>{link} →</a>
          </article>
        ))}
      </div>
      <article class="batch-highlight">
        <div>
          <p class="eyebrow">NUEVO / MULTI FUNCIONES</p>
          <h3>
            Varias consultas.
            <br />
            Una sola request.
          </h3>
          <p>
            Prepara SELECT, INSERT y UPDATE con .batch() y envía el conjunto a
            una conexión con Batch().exec().
          </p>
          <a href={withBase('/docs/multi-funciones/')}>
            Explorar las multi funciones →
          </a>
        </div>
        <div
          class="batch-pipeline"
          aria-label="SELECT, INSERT y UPDATE se reúnen en un lote para una conexión"
        >
          <div class="batch-operations">
            <span>SELECT</span>
            <span>INSERT</span>
            <span>UPDATE</span>
          </div>
          <span class="batch-arrow" aria-hidden="true">
            ↓
          </span>
          <div class="batch-request">
            Batch → 1 request → MySQL / PostgreSQL
          </div>
        </div>
      </article>
    </section>
    <section class="section closing">
      <div>
        <p class="eyebrow">EMPIEZA POR LO SIMPLE</p>
        <h2>
          Tu siguiente consulta
          <br />
          empieza aquí.
        </h2>
      </div>
      <div>
        <div class="install-command">
          <code>npm install zormz</code>
          <button data-copy aria-label="Copiar comando de instalación">
            Copiar
          </button>
        </div>
        <a class="text-link" href={withBase('/docs/instalacion/')}>
          Ir a la instalación →
        </a>
      </div>
    </section>
  </main>
</Layout>
