---
import { withBase, withoutBase } from '../lib/urls';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/docs.css';
import { tableLifecycle } from '../data/navigation';
const {
  title = 'Documentación',
  description = 'ZORMZ: ORM ligero en TypeScript para MySQL y PostgreSQL. Documentación en español con instalación, tablas, consultas SQL y ejemplos.',
} = Astro.props;
const pageTitle = `${title} — ZORMZ`;
const canonical = new URL(
  `${Astro.url.pathname.replace(/\/$/, '')}/`,
  Astro.site,
);
const home = new URL(withBase('/'), Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: 'ZORMZ',
      inLanguage: 'es',
      description:
        'Documentación de ZORMZ, ORM en TypeScript para MySQL y PostgreSQL.',
    },
    {
      '@type': 'WebPage',
      '@id': canonical.href,
      url: canonical.href,
      name: pageTitle,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${home}#website` },
      about: {
        '@type': 'SoftwareSourceCode',
        name: 'ZORMZ',
        programmingLanguage: 'TypeScript',
        url: 'https://www.npmjs.com/package/zormz',
      },
    },
  ],
};
const primaryDocs = [
  ...tableLifecycle,
  { slug: 'multi-funciones', title: 'Multi funciones' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="google-site-verification"
      content="rrTBM6ZTOpQE5K91BclqMQv38Pkhu_CL7v5_FfqLNto"
    />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link
      rel="sitemap"
      type="application/xml"
      href={withBase('/sitemap.xml')}
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZORMZ" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('theme') ||
          (matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header">
      <a class="brand" href={withBase('/')}>
        <span class="logo">Z</span> ZORMZ <span class="docs-label">/ docs</span>
      </a>
      <nav class="site-nav" aria-label="Principal">
        <a
          href={withBase('/')}
          aria-current={
            withoutBase(Astro.url.pathname) === '/' ? 'page' : undefined
          }
        >
          Introducción
        </a>
        {primaryDocs.map(({ slug, title }) => (
          <a
            href={withBase(`/docs/${slug}/`)}
            aria-current={
              withoutBase(Astro.url.pathname).includes(`/docs/${slug}`)
                ? 'page'
                : undefined
            }
          >
            {title}
          </a>
        ))}
        <a
          href={withBase('/docs/instalacion/')}
          aria-current={
            withoutBase(Astro.url.pathname).startsWith('/docs') &&
            !primaryDocs.some(({ slug }) =>
              withoutBase(Astro.url.pathname).includes(`/docs/${slug}`),
            )
              ? 'page'
              : undefined
          }
        >
          Guías
        </a>
        <a
          href="https://www.npmjs.com/package/zormz"
          target="_blank"
          rel="noreferrer"
        >
          npm ↗
        </a>
      </nav>
      <button class="theme-toggle" aria-label="Cambiar tema">
        <span></span>
      </button>
    </header>
    <slot />
    <footer class="site-footer">
      <p>
        ZORMZ{' '}
        <span class="footer-note">
          · Hecho para construir, sin complicaciones.
        </span>
      </p>
      <a href="https://github.com/kpab/astro-keel">Basado en Astro Keel ↗</a>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/code-copy';
      import '../scripts/docs-navigation';
      import '../scripts/column-reference';
      import '../scripts/type-tiles';
    </script>
  </body>
</html>
